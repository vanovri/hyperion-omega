{
  "name": "@hyperion/sovereign-studio",
  "version": "2.0.0",
  "private": true,
  "description": "HYPERION OMEGA Channel 20 — 3D WebGL2 GLSL Shader Command Workstation & Tauri v2 Native Desktop App",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "build:static": "node -e \"process.env.SOVEREIGN_STATIC_EXPORT='1'; require('child_process').execSync('npm run build', { stdio: 'inherit' });\"",
    "start": "next start -p 3001",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "tauri:dev": "tauri dev",
    "tauri:build": "npm run build:static && tauri build"
  },
  "dependencies": {
    "@microsoft/focusgroup-polyfill": "latest",
    "@tauri-apps/api": "^2.2.0",
    "next": "15.5.29",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.172.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.172.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
