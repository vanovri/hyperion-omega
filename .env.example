# ==============================================================================
# HYPERION MONOREPO — CANONICAL ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# --- Core Infrastructure ---
HYPERION_REDPANDA_BROKERS=localhost:19092
HYPERION_SCHEMA_REGISTRY_URL=http://localhost:18081
HYPERION_PG_USER=hyperion
HYPERION_PG_PASSWORD=hyperion_dev_secret
HYPERION_PG_DB=hyperion
HYPERION_PG_DSN=postgres://hyperion:hyperion_dev_secret@localhost:5432/hyperion?sslmode=disable
HYPERION_REDIS_URL=redis://localhost:6379/0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
HYPERION_PROMETHEUS_URL=http://localhost:9090
HYPERION_JAEGER_UI_URL=http://localhost:16686

# --- Microservice gRPC Endpoints (Outside Windows 50000-50059 Exclusion Range) ---
HYPERION_LEDGER_GRPC_ADDR=127.0.0.1:50151
HYPERION_STREAM_AGGREGATOR_GRPC_ADDR=127.0.0.1:50152
HYPERION_SENTINEL_ML_GRPC_ADDR=127.0.0.1:50153
HYPERION_CHRONOS_REPLAY_GRPC_ADDR=127.0.0.1:50154

# --- Microservice HTTP / WS / Control Plane Ports ---
HYPERION_GATEWAY_HTTP_PORT=8080
HYPERION_GATEWAY_METRICS_PORT=8081
HYPERION_LEDGER_METRICS_PORT=8082
HYPERION_STREAM_AGGREGATOR_HTTP_PORT=8083
HYPERION_SENTINEL_ML_HTTP_PORT=8084
HYPERION_AEGIS_AGENT_HTTP_PORT=8085
HYPERION_CHAOS_SIM_HTTP_PORT=8086
HYPERION_CHRONOS_REPLAY_HTTP_PORT=8088
HYPERION_TERMINAL_WEB_PORT=3000

# --- Deterministic WAL & Snapshot Storage ---
HYPERION_DATA_DIR=./data/ledger
